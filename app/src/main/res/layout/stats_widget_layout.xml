<?xml version="1.0" encoding="utf-8"?>
<!--
  Osu! Panel — Rank & Level Widget Layout

  Tiga baris kompak:
  1. Global rank
  2. Country rank
  3. Level + progress bar menuju level berikutnya
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stats_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp">

    <!-- Global rank -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/rank_global_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_rank_na"
            android:textColor="#FF82B1FF"
            android:textSize="17sp"
            android:fontFamily="@font/torus"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_global_rank_label"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/torus"
            android:gravity="end"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Country rank -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/rank_country_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_rank_na"
            android:textColor="#FFFFAB91"
            android:textSize="17sp"
            android:fontFamily="@font/torus"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_country_rank_label"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/torus"
            android:gravity="end"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Level + progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/level_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_level_value"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/torus"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/level_percent_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_zero_percent"
            android:textColor="#FFE86E9E"
            android:textSize="11sp"
            android:fontFamily="@font/torus"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Level progress bar -->
    <ProgressBar
        android:id="@+id/level_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />
</LinearLayout>
